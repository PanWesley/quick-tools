{
  "git": {
    "deploymentEnabled": {
      "main": false,
      "*": true
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.billnest.top"
        }
      ],
      "destination": "/tools/expense/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/analytics/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tools/expense/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tools/time/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tools/price/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tools/expense/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/tools/time/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/tools/price/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/quick-tools", "destination": "/index.html" },
    { "source": "/quick-tools/", "destination": "/index.html" },
    { "source": "/tools/expense", "destination": "/tools/expense/" },
    { "source": "/tools/expense/", "destination": "/tools/expense/index.html" },
    { "source": "/tools/time", "destination": "/tools/time/" },
    { "source": "/tools/time/", "destination": "/tools/time/index.html" },
    { "source": "/tools/price", "destination": "/tools/price/" },
    { "source": "/tools/price/", "destination": "/tools/price/index.html" },
    { "source": "/analytics", "destination": "/analytics/" },
    { "source": "/analytics/", "destination": "/analytics/index.html" }
  ]
}
