{
  "name": "billnest-price",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://billnest.top,https://www.billnest.top"
  },
  "kv_namespaces": [
    {
      "binding": "PRICE_KV",
      "id": "de55a60792cf44bf9beb2845c2aaaf4c"
    }
  ],
  "ratelimits": [
    {
      "name": "SNAPSHOT_CLIENT_LIMITER",
      "namespace_id": "21001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "SNAPSHOT_ITEM_LIMITER",
      "namespace_id": "21002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "billnest.top/api/price*",
      "zone_name": "billnest.top"
    },
    {
      "pattern": "www.billnest.top/api/price*",
      "zone_name": "billnest.top"
    }
  ]
}
